flowchart LR
    A["<b>1. Deteccao</b><br/>log WARN, alerta do<br/>Prometheus (429/403<br/>ou 5xx acima do limiar)<br/><i>Responsavel: on-call</i>"] --> B["<b>2. Analise</b><br/>filtrar por requestId/<br/>userId/IP; conferir<br/>audit_log; classificar<br/>severidade<br/><i>Responsavel: tecnico do modulo</i>"]
    B --> C["<b>3. Contencao</b><br/>bloqueio automatico<br/>de IP (forca bruta);<br/>revogar sessoes do<br/>usuario afetado<br/><i>Responsavel: tecnico + admin</i>"]
    C --> D["<b>4. Erradicacao</b><br/>corrigir causa raiz;<br/>rotacionar segredo<br/>se houver suspeita<br/>de vazamento<br/><i>Responsavel: tecnico do modulo</i>"]
    D --> E["<b>5. Recuperacao</b><br/>redeploy no Render;<br/>confirmar health check<br/>e pipeline verde<br/><i>Responsavel: tecnico do modulo</i>"]
    E --> F["<b>6. Pos-incidente</b><br/>registrar em<br/>contexto.md; comunicar<br/>a equipe; item na<br/>rotina de revisao<br/><i>Responsavel: tech lead</i>"]

    F -.dado pessoal exposto?.-> ANPD["<b>LGPD</b><br/>avaliar notificacao<br/>a ANPD e aos titulares<br/>em prazo razoavel<br/>(art. 48)"]

    G["<b>Severidade</b><br/>baixa: sem exploracao<br/>media: exploracao limitada<br/>alta/critica: dado pessoal<br/>ou credencial exposta"] -.orienta.-> B

    H["Exemplo real desta entrega:<br/>IP forjado via X-Forwarded-For<br/>contornava rate limit e forca bruta<br/>(severidade: media)"] -.aplicado a.-> A

