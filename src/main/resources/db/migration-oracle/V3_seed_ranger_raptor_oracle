DECLARE
    v_ford_id   RAW(16);
    v_ranger_id RAW(16);
    v_raptor_id RAW(16);
BEGIN

    -- Marca Ford
    v_ford_id := SYS_GUID();
    INSERT INTO marcas (id, nome, slug, is_ford)
    VALUES (v_ford_id, 'Ford', 'brand-ford', 1);

    -- Veiculo Ranger
    v_ranger_id := SYS_GUID();
    INSERT INTO veiculos (id, marca_id, nome, slug, segmento, mercado, ano_ini, is_ford)
    VALUES (v_ranger_id, v_ford_id, 'Ford Ranger', 'vehicle-ford-ranger-2025',
            'pickup', 'BR', 2024, 1);

    -- Versao Raptor
    v_raptor_id := SYS_GUID();
    INSERT INTO versoes (id, veiculo_id, nome, slug, powertrain, tracao, cabine, ano)
    VALUES (v_raptor_id, v_ranger_id,
            'Ranger Raptor 3.0 V6 EcoBoost Gasolina 4x4 Cabine Dupla',
            'version-ford-ranger-raptor-3-0-v6-ecoboost-gasolina-4x4-cabine-dupla-2025',
            'GASOLINA', '4X4', 'DUPLA', 2025);

    -- Atributos canonicos
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_motor','Motor','engine_transmission', NULL);
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_potencia_cv','Potencia','engine_transmission','cv');
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_torque_nm','Torque','engine_transmission','Nm');
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_transmissao','Transmissao','engine_transmission', NULL);
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_tracao','Tracao','traction_offroad', NULL);
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_cap_carga_kg','Capacidade de carga','capacity_use','kg');
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_cap_reboque_kg','Capacidade de reboque','capacity_use','kg');
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_pneus','Pneus','traction_offroad', NULL);
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_tanque_l','Tanque','capacity_use','L');
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_comprimento_mm','Comprimento','visual_finish','mm');
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_largura_mm','Largura','visual_finish','mm');
    INSERT INTO atributos_definicao (id, codigo, nome, categoria, unidade) VALUES
        (SYS_GUID(),'attr_altura_mm','Altura','visual_finish','mm');

    -- Sinonimos
    INSERT INTO atributo_sinonimos (atributo_id, sinonimo)
        SELECT id, 'potencia' FROM atributos_definicao WHERE codigo='attr_potencia_cv';
    INSERT INTO atributo_sinonimos (atributo_id, sinonimo)
        SELECT id, 'cv' FROM atributos_definicao WHERE codigo='attr_potencia_cv';
    INSERT INTO atributo_sinonimos (atributo_id, sinonimo)
        SELECT id, 'cavalos' FROM atributos_definicao WHERE codigo='attr_potencia_cv';
    INSERT INTO atributo_sinonimos (atributo_id, sinonimo)
        SELECT id, 'torque' FROM atributos_definicao WHERE codigo='attr_torque_nm';
    INSERT INTO atributo_sinonimos (atributo_id, sinonimo)
        SELECT id, 'consumo' FROM atributos_definicao WHERE codigo='attr_tanque_l';

    -- Especificacoes Ford Ranger Raptor 2025
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '3.0L V6 EcoBoost Biturbo'
        FROM atributos_definicao WHERE codigo='attr_motor';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '392'
        FROM atributos_definicao WHERE codigo='attr_potencia_cv';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '583'
        FROM atributos_definicao WHERE codigo='attr_torque_nm';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, 'Automatica 10 velocidades'
        FROM atributos_definicao WHERE codigo='attr_transmissao';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '4x4 com bloqueio de diferencial'
        FROM atributos_definicao WHERE codigo='attr_tracao';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '900'
        FROM atributos_definicao WHERE codigo='attr_cap_carga_kg';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '3500'
        FROM atributos_definicao WHERE codigo='attr_cap_reboque_kg';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '285/70 R17 BF Goodrich All-Terrain'
        FROM atributos_definicao WHERE codigo='attr_pneus';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '80'
        FROM atributos_definicao WHERE codigo='attr_tanque_l';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '5398'
        FROM atributos_definicao WHERE codigo='attr_comprimento_mm';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '2028'
        FROM atributos_definicao WHERE codigo='attr_largura_mm';
    INSERT INTO especificacoes (id, versao_id, atributo_id, valor)
        SELECT SYS_GUID(), v_raptor_id, id, '1940'
        FROM atributos_definicao WHERE codigo='attr_altura_mm';

    COMMIT;
END;
